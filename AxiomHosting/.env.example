# Copy this file to .env for local development. Choose your own strong password.
POSTGRES_DB=axiom_hosting
POSTGRES_USER=axiom_admin
POSTGRES_PASSWORD=replace_with_a_long_random_admin_password

# Least-privileged role used by the API (not a PostgreSQL superuser).
APP_DB_USER=axiom_app
APP_DB_PASSWORD=replace_with_a_different_long_random_app_password

# The host port used to reach the API from your computer.
API_PORT=3000
NODE_ENV=development

# Browser origin allowed to call the API. This is not a database setting.
CORS_ORIGIN=http://localhost:5173

# Optional public website settings. Never put secrets in VITE_ variables.
VITE_PING_ASHBURN_URL=
VITE_PING_US_EAST_URL=
VITE_PING_US_WEST_URL=
VITE_PING_EUROPE_WEST_URL=

VITE_SUPPORT_EMAIL=
VITE_PTERODACTYL_PANEL_URL=
